# SQLite-Datei (Pfad relativ zum Projektordner)
DATABASE_URL="file:./prisma/dev.db"

# Zeitzone für Datumsanzeigen und Eingaben
APP_TIMEZONE="Europe/Berlin"

# Session-Cookie nur über HTTPS senden. Standard: true im Produktivbetrieb.
# Auf "false" setzen, wenn die App ohne HTTPS (z. B. http://IP:3000) läuft.
# SESSION_COOKIE_SECURE="false"

# Schlüssel zum Verschlüsseln der Schließfach-Codes und -Passwörter.
# Im Produktivbetrieb Pflicht. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Wichtig: Wird der Schlüssel später geändert, sind gespeicherte Codes nicht mehr lesbar.
SECRET_KEY="bitte-aendern-langer-zufaelliger-wert"

# Nur für die Ersteinrichtung im Produktivbetrieb (/setup): Code, mit dem der erste
# President-Account angelegt wird. Lokal ohne Code möglich.
# SETUP_CODE="langer-zufaelliger-code"

# Postgres statt SQLite (z. B. auf Vercel mit Supabase):
# DATABASE_URL="postgresql://…:6543/postgres?pgbouncer=true&schema=unholy_reaper"   (Transaction Pooler, für die App)
# DIRECT_DATABASE_URL="postgresql://…:5432/postgres?schema=unholy_reaper"           (Session Pooler, für Migrationen)
